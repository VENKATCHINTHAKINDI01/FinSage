# ============================================================
# FinSage AI — Monorepo .gitignore
# ============================================================

# ── Environment & Secrets ─────────────────────────────────
.env
.env.*
!.env.example
!env.example
*.pem
*.key
*.crt

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.eggs/

# Virtual environments
senv/
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# PyInstaller
*.pyinstaller

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.log
.tox/

# mypy / ruff / pyright
.mypy_cache/
.ruff_cache/
.pytype/
pyrightconfig.json

# Jupyter
.ipynb_checkpoints

# ── Node / Frontend ───────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Build output
dist/
dist-ssr/
*.local
.output/

# TypeScript
*.tsbuildinfo
frontend/node_modules/.tmp/

# ── Database ──────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ── Docker ────────────────────────────────────────────────
.docker/

# ── IDEs & Editors ────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# ── Exports & Generated Reports ──────────────────────────
exports/
*.pdf
*.xlsx
*.csv

# ── Misc ─────────────────────────────────────────────────
*.bak
*.tmp
*.orig
.cache/