# ============================================================
# FinSage AI — Monorepo .gitignore
# ============================================================

# ── Environment & Secrets ─────────────────────────────────
.env
.env.*
!.env.example
!env.example
*.pem
*.key
*.crt

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.eggs/

# Virtual environments
senv/
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# PyInstaller
*.pyinstaller

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.log
.tox/
.hypothesis/

# Eval harness caches (recorded LLM fixtures ARE committed; live-run output is not)
backend/evals/.cache/
backend/evals/runs/

# mypy / ruff / pyright / importlinter
.mypy_cache/
.ruff_cache/
.pytype/
pyrightconfig.json
.import_linter_cache/

# Jupyter
.ipynb_checkpoints

# ── Node / Frontend ───────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Build output
dist/
dist-ssr/
*.local
.output/

# TypeScript
*.tsbuildinfo
frontend/node_modules/.tmp/

# ── Database ──────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ── Docker ────────────────────────────────────────────────
.docker/

# ── IDEs & Editors ────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# ── Generated user documents ─────────────────────────────
# Never commit generated financial documents. In production these live in the
# encrypted vault (DOC-004), not on local disk — exports/ is a dev-only artefact.
exports/
*.generated.pdf

# Blanket *.pdf / *.xlsx / *.csv is deliberately NOT used: Phase 4 parsers
# (Form 16, broker P&L, AIS) need committed sample fixtures to test against.
# Those live under tests/fixtures/ and must be synthetic — never real user data.
tests/fixtures/**/*.real.*
backend/**/tests/fixtures/**/*.real.*

# ── AI Tool Configs ───────────────────────────
.claude/
.agents/

# ── Generated Docs & Data ────────────────────
feature.json

# ── Misc ─────────────────────────────────────
*.bak
*.tmp
*.orig
.cache/